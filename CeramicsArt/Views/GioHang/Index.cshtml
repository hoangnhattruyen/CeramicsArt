
@model CeramicsArt.Models.GioHang

@{
    ViewData["Title"] = "Giỏ hàng - CeramicsArt";
    Layout = null;

    var chiTiets = Model.ChiTietGioHangs
        .OrderBy(x => x.Id)
        .ToList();

    int tongSoLuong = chiTiets.Sum(x => x.SoLuong);

    decimal tongTien = chiTiets.Sum(x =>
        (x.SanPham?.Gia ?? 0m) * x.SoLuong);

    string DinhDangTien(decimal gia)
    {
        return gia.ToString("N0") + " ₫";
    }
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Giỏ hàng - CeramicsArt</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #faf7f2;
            color: #403329;
            font-family: Arial, sans-serif;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* HEADER */

        .header {
            background: #ffffff;
            border-bottom: 1px solid #e9dfd5;
            padding: 22px 7%;
        }

        .header-inner {
            max-width: 1250px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .logo {
            font-size: 29px;
            font-family: Georgia, serif;
            font-weight: bold;
            color: #795136;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav a {
            color: #5a4636;
            font-size: 14px;
            font-weight: 600;
        }

        .nav a:hover {
            color: #b47b49;
        }

        .nav .active {
            color: #a56a3f;
        }

        /* CONTENT */

        .container {
            max-width: 1250px;
            margin: 45px auto 80px;
            padding: 0 25px;
        }

        .page-title {
            margin-bottom: 30px;
        }

        .page-title h1 {
            font-family: Georgia, serif;
            font-size: 34px;
            color: #4c3426;
            margin: 0 0 12px;
        }

        .page-title p {
            color: #958174;
            font-size: 14px;
            margin: 0;
        }

        .cart-layout {
            display: grid;
            grid-template-columns:
                minmax(0, 2fr)
                minmax(290px, 1fr);
            gap: 28px;
            align-items: start;
        }

        /* PRODUCT LIST */

        .cart-list {
            background: white;
            border-radius: 12px;
            border: 1px solid #ede2d7;
            overflow: hidden;
        }

        .cart-heading {
            background: #f0e5d9;
            padding: 20px 24px;
            font-weight: bold;
            color: #593c2a;
        }

        .cart-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 24px;
            border-bottom: 1px solid #f0e8e0;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .product-image {
            width: 115px;
            height: 115px;
            flex-shrink: 0;
            border-radius: 9px;
            overflow: hidden;
            background: #f1ebe4;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .image-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 42px;
            background: #eee2d5;
        }

        .product-info {
            flex: 1;
            min-width: 0;
        }

        .product-name {
            font-family: Georgia, serif;
            font-size: 19px;
            font-weight: bold;
            color: #51392b;
            margin-bottom: 10px;
        }

        .product-price {
            color: #a56c3c;
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .stock-info {
            font-size: 12px;
            color: #8b7c70;
            margin-bottom: 15px;
        }

        .item-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .quantity-form {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .quantity-input {
            width: 65px;
            height: 36px;
            text-align: center;
            border: 1px solid #d9c8b7;
            border-radius: 5px;
            font-size: 14px;
        }

        .btn-update {
            background: #795136;
            color: white;
            border: none;
            border-radius: 5px;
            padding: 11px 13px;
            font-size: 12px;
            cursor: pointer;
        }

        .btn-update:hover {
            background: #563824;
        }

        .btn-delete {
            background: #fff1ed;
            color: #b44733;
            border: 1px solid #f0c9bd;
            border-radius: 5px;
            padding: 10px 13px;
            font-size: 12px;
            cursor: pointer;
        }

        .btn-delete:hover {
            background: #f9ded6;
        }

        .item-total {
            min-width: 125px;
            text-align: right;
        }

        .item-total small {
            display: block;
            color: #9a8778;
            margin-bottom: 9px;
        }

        .item-total strong {
            color: #9e6538;
            font-size: 17px;
            white-space: nowrap;
        }

        /* ORDER SUMMARY */

        .summary {
            background: white;
            border: 1px solid #ede2d7;
            border-radius: 12px;
            padding: 26px;
        }

        .summary h2 {
            font-family: Georgia, serif;
            color: #503727;
            font-size: 23px;
            margin: 0 0 25px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            font-size: 14px;
            padding: 13px 0;
        }

        .summary-row span:first-child {
            color: #89776a;
        }

        .summary-divider {
            height: 1px;
            background: #e9e0d7;
            margin: 15px 0;
        }

        .grand-total {
            font-size: 17px;
            font-weight: bold;
        }

        .grand-total strong {
            font-size: 23px;
            color: #a56c3c;
        }

        .btn-checkout {
            display: block;
            width: 100%;
            text-align: center;
            margin-top: 25px;
            padding: 16px;
            border: none;
            border-radius: 7px;
            background: #795136;
            color: white;
            font-size: 14px;
            font-weight: bold;
        }

        .btn-checkout:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .btn-continue {
            display: block;
            text-align: center;
            border: 1px solid #d8c6b4;
            border-radius: 7px;
            padding: 15px;
            color: #795136;
            margin-top: 12px;
            font-size: 13px;
            font-weight: bold;
        }

        .btn-continue:hover {
            background: #f5ede5;
        }

        .summary-note {
            font-size: 12px;
            color: #958476;
            line-height: 1.7;
            text-align: center;
            margin-top: 18px;
        }

        /* EMPTY CART */

        .empty-cart {
            text-align: center;
            background: white;
            padding: 75px 20px;
            border: 1px solid #ede2d7;
            border-radius: 12px;
        }

        .empty-icon {
            font-size: 65px;
            margin-bottom: 20px;
        }

        .empty-cart h2 {
            color: #51392b;
            font-family: Georgia, serif;
            font-size: 25px;
        }

        .empty-cart p {
            color: #978576;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .btn-shop {
            display: inline-block;
            padding: 15px 27px;
            border-radius: 6px;
            background: #795136;
            color: white;
            font-weight: bold;
            font-size: 13px;
        }

        /* ALERT */

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 22px;
            font-size: 14px;
        }

        .alert-success {
            background: #e0f3e4;
            color: #276a3c;
        }

        .alert-error {
            background: #fbe4e0;
            color: #a43527;
        }

        /* FOOTER */

        .footer {
            background: #3d2c22;
            text-align: center;
            padding: 28px;
            color: #e7d6c7;
            font-size: 13px;
        }

        @@media (max-width: 900px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 600px) {
            .header-inner {
                flex-direction: column;
            }

            .nav {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
            }

            .container {
                margin: 25px auto 50px;
                padding: 0 15px;
            }

            .page-title h1 {
                font-size: 27px;
            }

            .cart-item {
                align-items: flex-start;
                flex-wrap: wrap;
                padding: 18px;
                gap: 12px;
            }

            .product-image {
                width: 90px;
                height: 90px;
            }

            .product-name {
                font-size: 16px;
            }

            .item-total {
                width: 100%;
                text-align: left;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->

    <header class="header">
        <div class="header-inner">

            <a asp-controller="Home"
               asp-action="Index"
               class="logo">
                CeramicsArt.
            </a>

            <nav class="nav">

                <a asp-controller="Home"
                   asp-action="Index">
                    Trang chủ
                </a>

                <a asp-controller="GioHang"
                   asp-action="Index"
                   class="active">
                    🛒 Giỏ hàng
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>
                        Xin chào, @User.Identity.Name
                    </span>
                }

            </nav>

        </div>
    </header>

    <!-- MAIN -->

    <main class="container">

        <div class="page-title">
            <h1>Giỏ hàng của bạn</h1>

            <p>
                Kiểm tra sản phẩm trước khi tiến hành đặt hàng.
            </p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                @TempData["Error"]
            </div>
        }

        @if (chiTiets.Count == 0)
        {
            <!-- GIỎ HÀNG TRỐNG -->

            <section class="empty-cart">

                <div class="empty-icon">🛒</div>

                <h2>Giỏ hàng của bạn đang trống</h2>

                <p>
                    Hãy khám phá các sản phẩm gốm sứ
                    nghệ thuật tại CeramicsArt.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn-shop">
                    KHÁM PHÁ SẢN PHẨM
                </a>

            </section>
        }
        else
        {
            <div class="cart-layout">

                <!-- DANH SÁCH SẢN PHẨM -->

                <section class="cart-list">

                    <div class="cart-heading">
                        Sản phẩm trong giỏ (@tongSoLuong)
                    </div>

                    @foreach (var item in chiTiets)
                    {
                        var sanPham = item.SanPham;

                        decimal donGia = sanPham?.Gia ?? 0m;

                        decimal thanhTien =
                            donGia * item.SoLuong;

                        <div class="cart-item">

                            <div class="product-image">

                                @if (sanPham != null &&
                                     !string.IsNullOrWhiteSpace(sanPham.HinhAnh))
                                {
                                    <img src="@sanPham.HinhAnh"
                                         alt="@sanPham.TenSanPham" />
                                }
                                else
                                {
                                    <div class="image-placeholder">
                                        🏺
                                    </div>
                                }

                            </div>

                            <div class="product-info">

                                <div class="product-name">
                                    @(sanPham?.TenSanPham
                                        ?? "Sản phẩm không còn tồn tại")
                                </div>

                                <div class="product-price">
                                    @DinhDangTien(donGia)
                                </div>

                                @if (sanPham != null)
                                {
                                    <div class="stock-info">
                                        Còn @sanPham.SoLuong sản phẩm
                                    </div>
                                }
                                else
                                {
                                    <div class="stock-info">
                                        Sản phẩm hiện không khả dụng
                                    </div>
                                }

                                <div class="item-actions">

                                    <!-- CẬP NHẬT SỐ LƯỢNG -->

                                    <form asp-controller="GioHang"
                                          asp-action="CapNhat"
                                          method="post"
                                          class="quantity-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="chiTietId"
                                               value="@item.Id" />

                                        <input type="number"
                                               name="soLuong"
                                               value="@item.SoLuong"
                                               min="1"
                                               max="100"
                                               required
                                               class="quantity-input"
                                               aria-label="Số lượng sản phẩm"
                                               disabled="@(sanPham == null)" />

                                        <button type="submit"
                                                class="btn-update"
                                                disabled="@(sanPham == null)">
                                            Cập nhật
                                        </button>

                                    </form>

                                    <!-- XÓA SẢN PHẨM -->

                                    <form asp-controller="GioHang"
                                          asp-action="Xoa"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="chiTietId"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn-delete"
                                                onclick="return confirm('Bạn muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                            Xóa
                                        </button>

                                    </form>

                                </div>

                            </div>

                            <div class="item-total">

                                <small>Thành tiền</small>

                                <strong>
                                    @DinhDangTien(thanhTien)
                                </strong>

                            </div>

                        </div>
                    }

                </section>

                <!-- TỔNG KẾT ĐƠN HÀNG -->

                <aside class="summary">

                    <h2>Tổng kết giỏ hàng</h2>

                    <div class="summary-row">

                        <span>Số lượng sản phẩm</span>

                        <strong>@tongSoLuong</strong>

                    </div>

                    <div class="summary-row">

                        <span>Tạm tính</span>

                        <strong>
                            @DinhDangTien(tongTien)
                        </strong>

                    </div>

                    <div class="summary-row">

                        <span>Phí vận chuyển</span>

                        <span>Chưa tính</span>

                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-row grand-total">

                        <span>Tạm tính</span>

                        <strong>
                            @DinhDangTien(tongTien)
                        </strong>

                    </div>

                    <!-- THANH TOÁN SẼ ĐƯỢC LÀM Ở BƯỚC SAU -->

                    
                    <!-- CHUYỂN ĐẾN TRANG ĐẶT HÀNG COD -->

                    <a asp-controller="DatHang"
                       asp-action="Index"
                       class="btn-checkout">
                        🛒 TIẾN HÀNH ĐẶT HÀNG
                    </a>


                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn-continue">
                        ← Tiếp tục mua sắm
                    </a>

                    <p class="summary-note">
                        Chức năng đặt hàng đang được xây dựng.
                        Giá và số lượng tồn kho sẽ được kiểm tra
                        lại khi xác nhận đơn hàng.
                    </p>

                </aside>

            </div>
        }

    </main>

    <!-- FOOTER -->

    <footer class="footer">
        © 2026 CeramicsArt.
        Nghệ thuật gốm sứ trong từng sản phẩm.
    </footer>

</body>
</html>
