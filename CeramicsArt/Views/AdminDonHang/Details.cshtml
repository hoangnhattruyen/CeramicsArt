
@model CeramicsArt.Models.DonHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng - CeramicsArt";
    Layout = null;

    var trangThaiHienTai = Model.TrangThai;

    // Xác định các trạng thái được phép chuyển đến
    var trangThaiTiepTheo = new List<string>();

    if (trangThaiHienTai == "Cho xac nhan")
    {
        trangThaiTiepTheo.Add("Da xac nhan");
        trangThaiTiepTheo.Add("Da huy");
    }
    else if (trangThaiHienTai == "Da xac nhan")
    {
        trangThaiTiepTheo.Add("Dang giao");
        trangThaiTiepTheo.Add("Da huy");
    }
    else if (trangThaiHienTai == "Dang giao")
    {
        trangThaiTiepTheo.Add("Hoan thanh");
    }

    string TenTrangThai(string trangThai) => trangThai switch
    {
        "Cho xac nhan" => "Chờ xác nhận",
        "Da xac nhan" => "Đã xác nhận",
        "Dang giao" => "Đang giao",
        "Hoan thanh" => "Hoàn thành",
        "Da huy" => "Đã hủy",
        _ => trangThai
    };

    var statusClass = trangThaiHienTai switch
    {
        "Cho xac nhan" => "pending",
        "Da xac nhan" => "confirmed",
        "Dang giao" => "shipping",
        "Hoan thanh" => "completed",
        "Da huy" => "cancelled",
        _ => ""
    };

    var tongChiTiet = Model.ChiTietDonHangs
        .Sum(x => x.ThanhTien);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Chi tiết đơn hàng #@Model.Id - CeramicsArt</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f4ee;
            color: #403329;
            font-family: Arial, sans-serif;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 250px;
            flex-shrink: 0;
            background: #3d2c22;
            color: white;
            padding: 28px 18px;
        }

        .logo {
            color: #e8c59d;
            font-family: Georgia, serif;
            font-size: 27px;
            font-weight: bold;
            padding: 0 12px;
            margin-bottom: 40px;
        }

        .menu-label {
            color: #c7b19e;
            font-size: 11px;
            letter-spacing: 2px;
            margin-bottom: 15px;
            padding: 0 12px;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .menu a,
        .menu button {
            display: block;
            width: 100%;
            padding: 14px 15px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: #eaded2;
            font-size: 13px;
            font-family: inherit;
            text-align: left;
            cursor: pointer;
        }

        .menu a:hover,
        .menu button:hover,
        .menu a.active {
            background: #74543c;
            color: white;
        }

        .menu a.active {
            font-weight: bold;
        }

        .menu form {
            margin: 0;
        }

        /* MAIN */

        .main {
            flex: 1;
            min-width: 0;
            padding: 35px 40px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
        }

        h1 {
            font-size: 29px;
            margin: 0;
            color: #493629;
        }

        .subtitle {
            margin-top: 10px;
            color: #938071;
            font-size: 13px;
        }

        .back-link {
            display: inline-block;
            background: #eee5dc;
            color: #543c2a;
            padding: 12px 18px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: bold;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
            gap: 25px;
        }

        .card {
            background: white;
            border: 1px solid #eee4d8;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 6px 25px rgba(0,0,0,.04);
        }

        .card h2 {
            font-size: 19px;
            color: #493629;
            margin: 0 0 22px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 12px 0;
            border-bottom: 1px solid #f0e9e2;
            font-size: 13px;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #938071;
            flex-shrink: 0;
        }

        .info-value {
            color: #493629;
            font-weight: 600;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .address {
            line-height: 1.8;
        }

        .status {
            display: inline-block;
            padding: 9px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .pending {
            background: #fff0ce;
            color: #94600d;
        }

        .confirmed {
            background: #dfeaff;
            color: #305b9b;
        }

        .shipping {
            background: #e6defb;
            color: #6844a0;
        }

        .completed {
            background: #dff3e3;
            color: #27713e;
        }

        .cancelled {
            background: #fbe0e0;
            color: #ac3333;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 520px;
            border-collapse: collapse;
        }

        th {
            background: #f2e8dd;
            color: #5c3c27;
            padding: 14px;
            font-size: 12px;
            text-align: left;
        }

        td {
            padding: 15px 14px;
            font-size: 13px;
            border-bottom: 1px solid #eee7df;
        }

        .product-name {
            font-weight: bold;
            color: #543826;
        }

        .price {
            color: #a46b39;
            font-weight: bold;
            white-space: nowrap;
        }

        .total-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding-top: 20px;
            margin-top: 12px;
            border-top: 2px solid #eee4d8;
        }

        .total-value {
            font-size: 23px;
            font-weight: bold;
            color: #a46b39;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 10px;
            color: #543c2a;
        }

        .form-control {
            display: block;
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #ded3c7;
            border-radius: 6px;
            font-size: 13px;
            font-family: inherit;
            background: white;
        }

        .btn-save {
            width: 100%;
            border: none;
            background: #744a32;
            color: white;
            padding: 14px 20px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: bold;
            cursor: pointer;
        }

        .btn-save:hover {
            background: #54331f;
        }

        .notice {
            background: #f2e8dd;
            color: #735137;
            padding: 16px;
            border-radius: 6px;
            font-size: 13px;
            line-height: 1.8;
        }

        .alert {
            padding: 14px 18px;
            margin-bottom: 20px;
            border-radius: 7px;
            font-size: 13px;
        }

        .alert-success {
            background: #dff3e3;
            color: #27713e;
        }

        .alert-error {
            background: #fbe0e0;
            color: #ac3333;
        }

        .footer {
            margin-top: 35px;
            color: #a18e80;
            font-size: 12px;
            text-align: center;
        }

        @@media (max-width: 1050px) {
            .detail-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 650px) {
            .admin-layout {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                padding: 20px 15px;
            }

            .logo {
                margin-bottom: 20px;
            }

            .menu {
                flex-direction: row;
                flex-wrap: wrap;
            }

            .menu a,
            .menu button {
                width: auto;
                padding: 10px;
                font-size: 12px;
            }

            .main {
                padding: 20px 15px;
            }

            h1 {
                font-size: 24px;
            }

            .card {
                padding: 18px;
            }

            .info-row {
                flex-direction: column;
                gap: 6px;
            }

            .info-value {
                text-align: left;
            }
        }
    </style>
</head>

<body>

    <div class="admin-layout">

        <!-- MENU ADMIN -->

        <aside class="sidebar">
            <div class="logo">CeramicsArt.</div>

            <div class="menu-label">
                QUẢN TRỊ HỆ THỐNG
            </div>

            <nav class="menu">

                <a href="/Admin">
                    📊 Tổng quan
                </a>

                <a href="/AdminSanPham">
                    🏺 Quản lý sản phẩm
                </a>

                <a href="/AdminDanhMuc">
                    📁 Quản lý danh mục
                </a>

                <a href="/AdminKhachHang">
                    👥 Quản lý khách hàng
                </a>

                <a href="/AdminDonHang" class="active">
                    🛒 Quản lý đơn hàng
                </a>

                <a href="/">
                    🏠 Xem website
                </a>

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit">
                        🚪 Đăng xuất
                    </button>
                </form>

            </nav>
        </aside>

        <!-- NỘI DUNG -->

        <main class="main">

            <div class="page-header">
                <div>
                    <h1>Chi tiết đơn hàng #@Model.Id</h1>

                    <p class="subtitle">
                        Xem thông tin và cập nhật trạng thái đơn hàng.
                    </p>
                </div>

                <a href="/AdminDonHang"
                   class="back-link">
                    ← Danh sách đơn hàng
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    @TempData["Error"]
                </div>
            }

            <div class="detail-grid">

                <!-- CỘT TRÁI -->

                <div>

                    <section class="card">

                        <h2>Thông tin khách hàng</h2>

                        <div class="info-row">
                            <span class="info-label">Họ tên</span>
                            <span class="info-value">@Model.HoTen</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Email</span>
                            <span class="info-value">@Model.Email</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Số điện thoại</span>
                            <span class="info-value">@Model.SoDienThoai</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Địa chỉ giao hàng</span>
                            <span class="info-value address">
                                @Model.DiaChi
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Ngày đặt (UTC)</span>
                            <span class="info-value">
                                @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                    </section>

                    <section class="card">

                        <h2>Sản phẩm trong đơn hàng</h2>

                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Đơn giá</th>
                                        <th>SL</th>
                                        <th>Thành tiền</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model.ChiTietDonHangs)
                                    {
                                        <tr>
                                            <td class="product-name">
                                                @item.TenSanPham
                                            </td>

                                            <td>
                                                @item.Gia.ToString("N0") đ
                                            </td>

                                            <td>@item.SoLuong</td>

                                            <td class="price">
                                                @item.ThanhTien.ToString("N0") đ
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="total-box">
                            <strong>TỔNG TIỀN ĐƠN HÀNG</strong>

                            <span class="total-value">
                                @Model.TongTien.ToString("N0") đ
                            </span>
                        </div>

                        @if (Model.ChiTietDonHangs.Any()
                            && tongChiTiet != Model.TongTien)
                        {
                            <p class="notice">
                                Tổng tiền trong đơn hàng khác với
                                tổng thành tiền các sản phẩm.
                                Vui lòng kiểm tra dữ liệu.
                            </p>
                        }

                    </section>

                </div>

                <!-- CỘT PHẢI -->

                <div>

                    <section class="card">

                        <h2>Trạng thái đơn hàng</h2>

                        <div class="form-group">
                            <span class="status @statusClass">
                                @TenTrangThai(trangThaiHienTai)
                            </span>
                        </div>

                        @if (trangThaiTiepTheo.Any())
                        {
                            <form asp-controller="AdminDonHang"
                                  asp-action="CapNhatTrangThai"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.Id" />

                                <div class="form-group">

                                    <label for="trangThai">
                                        Chuyển sang trạng thái
                                    </label>

                                    <select name="trangThai"
                                            id="trangThai"
                                            class="form-control"
                                            required>

                                        @foreach (var trangThai in trangThaiTiepTheo)
                                        {
                                            <option value="@trangThai">
                                                @TenTrangThai(trangThai)
                                            </option>
                                        }

                                    </select>

                                </div>

                                <button type="submit"
                                        class="btn-save">
                                    CẬP NHẬT TRẠNG THÁI
                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="notice">
                                Đơn hàng này đã hoàn thành,
                                đã hủy hoặc không có bước xử lý
                                tiếp theo được phép.
                            </div>
                        }

                    </section>

                    <section class="card">
                        <h2>Thông tin đơn hàng</h2>

                        <div class="info-row">
                            <span class="info-label">Mã đơn</span>
                            <span class="info-value">#@Model.Id</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Tổng số sản phẩm</span>
                            <span class="info-value">
                                @Model.ChiTietDonHangs.Sum(x => x.SoLuong)
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Tổng tiền</span>
                            <span class="info-value">
                                @Model.TongTien.ToString("N0") đ
                            </span>
                        </div>
                    </section>

                </div>

            </div>

            <div class="footer">
                © 2026 CeramicsArt - Admin Dashboard
            </div>

        </main>
    </div>

</body>
</html>
