
@model IEnumerable<CeramicsArt.Models.ViewModels.KhachHangAdminViewModel>

@{
    ViewData["Title"] = "Quản lý khách hàng - CeramicsArt";
    Layout = null;
    var khachHangs = Model?.ToList()
        ?? new List<CeramicsArt.Models.ViewModels.KhachHangAdminViewModel>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Quản lý khách hàng - CeramicsArt</title>

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f4ee;
            font-family: 'Be Vietnam Pro', sans-serif;
            color: #403329;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            flex-shrink: 0;
            background: #3d2c22;
            color: #fff;
            padding: 28px 18px;
        }

        .logo {
            color: #e8c59d;
            font-family: Georgia, serif;
            font-size: 27px;
            font-weight: bold;
            margin-bottom: 40px;
            padding: 0 12px;
        }

        .menu-label {
            color: #c7b19e;
            font-size: 11px;
            letter-spacing: 2px;
            margin-bottom: 15px;
            padding: 0 12px;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .menu a,
        .menu button {
            display: block;
            width: 100%;
            padding: 14px 15px;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: #eaded2;
            text-align: left;
            font-family: inherit;
            font-size: 13px;
            cursor: pointer;
        }

        .menu a:hover,
        .menu button:hover,
        .menu a.active {
            background: #74543c;
            color: #fff;
        }

        .menu a.active {
            font-weight: 700;
        }

        .menu form {
            margin: 0;
        }

        .main {
            flex: 1;
            min-width: 0;
            padding: 35px 40px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        h1 {
            margin: 0;
            font-size: 29px;
            color: #493629;
        }

        .subtitle {
            margin: 10px 0 0;
            color: #938071;
            font-size: 13px;
        }

        .count-badge {
            background: #e9d6c0;
            color: #664127;
            padding: 12px 18px;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
        }

        .toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #fff;
            border: 1px solid #eee4d8;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 22px;
        }

        .search-input {
            flex: 1;
            min-width: 0;
            padding: 13px 15px;
            border: 1px solid #ded3c7;
            border-radius: 6px;
            font-family: inherit;
            font-size: 13px;
        }

        .search-input:focus {
            outline: none;
            border-color: #a77b53;
        }

        .table-wrapper {
            background: #fff;
            border: 1px solid #eee4d8;
            border-radius: 12px;
            overflow-x: auto;
            box-shadow: 0 6px 25px rgba(0,0,0,.04);
        }

        table {
            width: 100%;
            min-width: 750px;
            border-collapse: collapse;
        }

        th {
            background: #ede0d0;
            color: #5c3c27;
            padding: 17px;
            font-size: 13px;
            text-align: left;
        }

        td {
            padding: 17px;
            border-bottom: 1px solid #eee7df;
            font-size: 13px;
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .customer-name {
            font-weight: 700;
            color: #543826;
        }

        .email {
            color: #816f61;
            overflow-wrap: anywhere;
        }

        .role-badge {
            display: inline-block;
            background: #e3eee4;
            color: #327345;
            padding: 7px 11px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .empty {
            padding: 45px 20px;
            color: #907d6e;
            text-align: center;
        }

        .footer {
            margin-top: 45px;
            text-align: center;
            color: #a18e80;
            font-size: 12px;
        }

        @@media (max-width: 850px) {
            .sidebar {
                width: 205px;
            }

            .main {
                padding: 25px;
            }
        }

        @@media (max-width: 650px) {
            .admin-layout {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                padding: 20px 15px;
            }

            .logo {
                margin-bottom: 20px;
            }

            .menu {
                flex-direction: row;
                flex-wrap: wrap;
            }

            .menu a,
            .menu button {
                width: auto;
                padding: 10px;
                font-size: 12px;
            }

            .main {
                padding: 20px 15px;
            }

            h1 {
                font-size: 24px;
            }

            .toolbar {
                padding: 12px;
            }
        }
    </style>
</head>

<body>

    <div class="admin-layout">

        <aside class="sidebar">

            <div class="logo">
                CeramicsArt.
            </div>

            <div class="menu-label">
                QUẢN TRỊ HỆ THỐNG
            </div>

            <nav class="menu">

                <a href="/Admin">
                    📊 Tổng quan
                </a>

                <a href="/AdminSanPham">
                    🏺 Quản lý sản phẩm
                </a>

                <a href="/AdminDanhMuc">
                    📁 Quản lý danh mục
                </a>

                <a href="/AdminKhachHang" class="active">
                    👥 Quản lý khách hàng
                </a>

                <a href="/">
                    🏠 Xem website
                </a>

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit">
                        🚪 Đăng xuất
                    </button>
                </form>

            </nav>
        </aside>

        <main class="main">

            <div class="page-header">

                <div>
                    <h1>Quản lý khách hàng</h1>

                    <p class="subtitle">
                        Danh sách tài khoản khách hàng
                        đã đăng ký tại CeramicsArt.
                    </p>
                </div>

                <div class="count-badge">
                    Tổng khách hàng: @khachHangs.Count
                </div>

            </div>

            <div class="toolbar">

                <input type="search"
                       id="searchCustomer"
                       class="search-input"
                       placeholder="Tìm khách hàng theo tên hoặc email..."
                       aria-label="Tìm kiếm khách hàng" />

            </div>

            <div class="table-wrapper">

                <table id="customerTable">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày đăng ký (UTC)</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in khachHangs)
                        {
                            <tr class="customer-row">

                                <td>@item.Id</td>

                                <td class="customer-name">
                                    @item.HoTen
                                </td>

                                <td class="email">
                                    @item.Email
                                </td>

                                <td>
                                    <span class="role-badge">
                                        @item.VaiTro
                                    </span>
                                </td>

                                <td>
                                    @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>

                <div id="emptyMessage"
                     class="empty"
                     style="display:none">
                    Không tìm thấy khách hàng phù hợp.
                </div>

            </div>

            <div class="footer">
                © 2026 CeramicsArt - Admin Dashboard
            </div>

        </main>

    </div>

    <script>
        const searchInput =
            document.getElementById("searchCustomer");

        const rows =
            document.querySelectorAll(".customer-row");

        const emptyMessage =
            document.getElementById("emptyMessage");

        function filterCustomers() {
            const keyword = searchInput.value
                .trim()
                .toLocaleLowerCase("vi");

            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.querySelector(".customer-name")
                    .textContent.toLocaleLowerCase("vi");

                const email = row.querySelector(".email")
                    .textContent.toLocaleLowerCase("vi");

                const matched =
                    name.includes(keyword) ||
                    email.includes(keyword);

                row.style.display = matched ? "" : "none";

                if (matched) {
                    visibleCount++;
                }
            });

            emptyMessage.style.display =
                visibleCount === 0 ? "block" : "none";
        }

        searchInput.addEventListener("input", filterCustomers);

        filterCustomers();
    </script>

</body>
</html>
